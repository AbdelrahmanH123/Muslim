{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "expo-constants": ["./shims/expo-constants.ts"],
      "expo-network": ["./shims/expo-network.ts"],
      "react-native": ["./shims/react-native.ts"]
    }
  },
  "include": ["*.ts", "*.mts", "shims/*.ts", "../../src/lib/*.ts"]
}
