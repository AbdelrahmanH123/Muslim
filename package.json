{
  "name": "muslim",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "adhan": "^4.4.6",
    "expo": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.17",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "data": "node scripts/build-data.mjs",
    "build:web": "expo export --platform web && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "verify": "python3 scripts/verify/verify_data.py && npx --yes tsx --tsconfig scripts/verify/tsconfig.json scripts/verify/eval_search.mts"
  },
  "private": true
